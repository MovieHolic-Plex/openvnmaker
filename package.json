{
  "name": "vnmaker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @vnmaker/app dev",
    "dev:gateway": "pnpm --filter @vnmaker/gateway dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node tools/audio-check.mjs && node --test tools/momus-gate-doctor.test.mjs",
    "e2e": "playwright test",
    "qa:gateway": "node tools/qa/gateway-live.mjs",
    "qa:image": "node tools/qa/image-live.mjs",
    "qa:generate": "node tools/qa/generate-live.mjs",
    "qa:hello": "node tools/qa/hello-browser.mjs",
    "qa:docs": "node tools/qa/docs-regression.mjs",
    "qa:audio": "node tools/audio-check.mjs",
    "assets:audio": "node tools/audio-gen.mjs",
    "doctor:momus": "node tools/momus-gate-doctor.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "lamejs": "1.2.1",
    "typescript": "5.9.3"
  }
}
