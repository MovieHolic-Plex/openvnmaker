{
  "name": "@vnmaker/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx test/credentials.test.ts test/routes.test.ts test/models.test.ts test/images.test.ts test/generate.test.ts test/project.test.ts"
  },
  "dependencies": {
    "hono": "4.13.5",
    "@hono/node-server": "2.1.1",
    "open": "11.0.2"
  },
  "devDependencies": {
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "@types/node": "26.4.0"
  }
}
